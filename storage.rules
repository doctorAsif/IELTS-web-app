rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isStaff() {
      return isAuthenticated() && (request.auth.token.role == 'superadmin' || request.auth.token.role == 'admin' || request.auth.token.role == 'teacher' || request.auth.token.role == 'counselor');
    }

    match /{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }
  }
}
